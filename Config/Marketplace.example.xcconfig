// Public client configuration only. Copy to Config/Marketplace.local.xcconfig.
// Never add service-role keys, database passwords, signing private keys, or VM credentials.
WALI_MARKETPLACE_ENABLED = YES
WALI_SUPABASE_URL = https:/$()/PROJECT_REF.supabase.co
WALI_SUPABASE_PUBLISHABLE_KEY = sb_publishable_REPLACE_ME
WALI_CATALOG_CDN_HOST = PROJECT_REF.supabase.co
WALI_CATALOG_SIGNING_KEY_ID = catalog-local-1
WALI_CATALOG_SIGNING_PUBLIC_KEY_BASE64 = REPLACE_WITH_PUBLIC_KEY_ONLY
WALI_CATALOG_RECOVERY_SIGNING_KEY_ID = catalog-recovery-1
WALI_CATALOG_RECOVERY_SIGNING_PUBLIC_KEY_BASE64 = REPLACE_WITH_OFFLINE_RECOVERY_PUBLIC_KEY_ONLY
// Public HTTPS location containing the versioned docs/legal files.
WALI_LEGAL_BASE_URL = https:/$()/github.com/CodeWithInferno/WALI/blob/main/docs/legal
