# syntax=docker/dockerfile:1.7

# WALI's worker VM is x86-64; this is the immutable linux/amd64 manifest.
FROM --platform=linux/amd64 docker.io/library/debian:bookworm-slim@sha256:5ae3c39ebd15e229dcedd5cee596b2497182493d41ff162e824ba13fc1b2b867 AS build

ARG DEBIAN_SNAPSHOT=20260824T000000Z
ARG FFMPEG_VERSION=7.1.2
ARG FFMPEG_SHA256=089bc60fb59d6aecc5d994ff530fd0dcb3ee39aa55867849a2bbc4e555f9c304
ARG KVAZAAR_VERSION=2.3.1
ARG KVAZAAR_SHA256=ca30575026d2f1a1201af4b94697bb0fcd05913388008631dc3332bae94122bd

RUN rm -f /etc/apt/sources.list.d/debian.sources \
    && printf 'deb [check-valid-until=no] http://snapshot.debian.org/archive/debian/%s bookworm main\n' "$DEBIAN_SNAPSHOT" >/etc/apt/sources.list \
    && printf 'Acquire::Check-Valid-Until "false";\n' >/etc/apt/apt.conf.d/99snapshot \
    && apt-get update \
    && apt-get install -y --no-install-recommends build-essential ca-certificates curl libtool nasm patch pkg-config xz-utils zlib1g-dev

WORKDIR /build
COPY patches/ffmpeg-7.1.2-libkvazaar-10bit.patch /tmp/ffmpeg-7.1.2-libkvazaar-10bit.patch
RUN curl --fail --location --proto '=https' --tlsv1.2 \
      "https://github.com/ultravideo/kvazaar/releases/download/v${KVAZAAR_VERSION}/kvazaar-${KVAZAAR_VERSION}.tar.xz" -o kvazaar.tar.xz \
    && printf '%s  %s\n' "$KVAZAAR_SHA256" kvazaar.tar.xz | sha256sum --check --strict \
    && mkdir kvazaar \
    && tar --extract --xz --file kvazaar.tar.xz --directory kvazaar --strip-components=1 \
    && cd kvazaar \
    && CPPFLAGS="-DKVZ_BIT_DEPTH=10" CFLAGS="-O2 -g -DKVZ_BIT_DEPTH=10" ./configure --prefix=/opt/kvazaar \
    && make -j2 \
    && make install

RUN curl --fail --location --proto '=https' --tlsv1.2 \
      "https://ffmpeg.org/releases/ffmpeg-${FFMPEG_VERSION}.tar.xz" -o ffmpeg.tar.xz \
    && printf '%s  %s\n' "$FFMPEG_SHA256" ffmpeg.tar.xz | sha256sum --check --strict \
    && mkdir ffmpeg \
    && tar --extract --xz --file ffmpeg.tar.xz --directory ffmpeg --strip-components=1 \
    && patch --directory ffmpeg --strip=1 --input /tmp/ffmpeg-7.1.2-libkvazaar-10bit.patch \
    && cd ffmpeg \
    && PKG_CONFIG_PATH=/opt/kvazaar/lib/pkgconfig ./configure \
      --prefix=/opt/ffmpeg --disable-autodetect --disable-doc --disable-debug \
      --disable-network --disable-gpl --disable-nonfree --disable-iconv \
      --disable-everything --enable-ffmpeg --enable-ffprobe \
      --enable-avcodec --enable-avformat --enable-avfilter --enable-swscale --enable-zlib \
      --enable-protocol=file,pipe --enable-demuxer=mov,image2 --enable-muxer=mp4,image2 \
      --enable-decoder=h264,hevc,mjpeg,png --enable-encoder=libkvazaar,mjpeg,png \
      --enable-parser=h264,hevc,mjpeg,png --enable-libkvazaar --enable-bsf=hevc_mp4toannexb \
      --enable-filter=scale,crop,pad,thumbnail,select,fps,format,setpts \
    && make -j2 \
    && make install

FROM --platform=linux/amd64 docker.io/library/debian:bookworm-slim@sha256:5ae3c39ebd15e229dcedd5cee596b2497182493d41ff162e824ba13fc1b2b867
ARG DEBIAN_SNAPSHOT=20260824T000000Z
RUN rm -f /etc/apt/sources.list.d/debian.sources \
    && printf 'deb [check-valid-until=no] http://snapshot.debian.org/archive/debian/%s bookworm main\n' "$DEBIAN_SNAPSHOT" >/etc/apt/sources.list \
    && printf 'Acquire::Check-Valid-Until "false";\n' >/etc/apt/apt.conf.d/99snapshot \
    && apt-get update \
    && apt-get install -y --no-install-recommends jq ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /opt/ffmpeg /opt/ffmpeg
COPY --from=build /opt/kvazaar/lib /opt/wali/lib
COPY policy/ffmpeg-policy.json /opt/wali/policy/ffmpeg-policy.json
COPY bin/process-media bin/verify-media /opt/wali/bin/

ENV PATH=/opt/ffmpeg/bin:/usr/bin:/bin \
    LD_LIBRARY_PATH=/opt/wali/lib \
    HOME=/nonexistent \
    TMPDIR=/tmp
USER 65532:65532
WORKDIR /work
ENTRYPOINT []
CMD ["/opt/wali/bin/process-media"]
