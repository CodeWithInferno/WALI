[Unit]
Description=WALI marketplace media worker
Documentation=file:/usr/share/doc/wali-worker/media-worker.md
After=network-online.target wali-podman-namespace.service
Requires=wali-podman-namespace.service
Wants=network-online.target
ConditionFileIsExecutable=/opt/wali-worker/current/wali-media-worker
ConditionPathExists=/etc/wali-worker/worker.env
X-WALI-Managed=true

[Service]
Type=simple
User=wali-worker
Group=wali-worker
EnvironmentFile=/etc/wali-worker/worker.env
Environment=HOME=/var/lib/wali-worker
Environment=XDG_RUNTIME_DIR=/run/wali-media-worker
Environment=CONTAINERS_STORAGE_CONF=/etc/wali-worker/storage.conf
ExecStart=/opt/wali-worker/current/wali-media-worker
Restart=on-failure
RestartSec=15s
TimeoutStartSec=30s
TimeoutStopSec=30s
KillMode=mixed
UMask=0077

RuntimeDirectory=wali-media-worker
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
StateDirectory=wali-worker
StateDirectoryMode=0700
CacheDirectory=wali-worker
CacheDirectoryMode=0700
ReadWritePaths=/var/lib/wali-worker /var/cache/wali-worker /run/wali-media-worker
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
BindPaths=/dev/fuse
DeviceAllow=/dev/fuse rw
PrivateMounts=yes
NoNewPrivileges=yes
RestrictSUIDSGID=yes
ProtectClock=yes
# The OCI runtime sets the hostname inside its private UTS namespace.
# Host hostname changes still require capabilities this service does not have.
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProcSubset=all
LockPersonality=yes
SystemCallArchitectures=native
MemoryDenyWriteExecute=yes
RemoveIPC=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
Delegate=yes

MemoryHigh=5G
MemoryMax=6G
CPUQuota=250%
TasksMax=256
LimitNOFILE=8192
LimitNPROC=512

[Install]
WantedBy=multi-user.target
