# Copy to /etc/wali-worker/worker.env as root:wali-worker mode 0640.
# This example contains placeholders only. Never commit a populated copy.
WALI_DATABASE_URL=postgresql://wali_worker_runtime:REPLACE_WITH_SCOPED_PASSWORD@staging-db.example.invalid:5432/postgres?sslmode=verify-full
WALI_STORAGE_URL=https://staging-project.example.invalid
WALI_STORAGE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_PROJECT_KEY
WALI_STORAGE_WORKER_TOKEN=REPLACE_WITH_WALI_STORAGE_WORKER_RLS_JWT
WALI_WORKER_ID=wali-worker-01
WALI_QUEUE_NAME=wali_media_processing
WALI_SCRATCH_ROOT=/var/lib/wali-worker/attempts
WALI_PODMAN_PATH=/usr/bin/podman
WALI_MEDIA_IMAGE=registry.example.invalid/wali/media@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
WALI_VERIFIER_IMAGE=registry.example.invalid/wali/media@sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
WALI_CLASSIFIER_IMAGE=registry.example.invalid/wali/classifier@sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
WALI_MEDIA_POLICY_DIGEST=dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd
WALI_HEALTH_SOCKET=/run/wali-media-worker/health.sock
